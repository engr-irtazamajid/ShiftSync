{
  "name": "shiftsync",
  "private": true,
  "workspaces": [
    "packages/shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=server && npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server",
    "typecheck": "npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "lint": "eslint server/src client/src packages/shared/src",
    "format": "prettier --write \"server/src/**/*.ts\" \"server/scripts/**/*.ts\" \"server/tests/**/*.ts\" \"client/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.ts\"",
    "format:check": "prettier --check \"server/src/**/*.ts\" \"server/scripts/**/*.ts\" \"server/tests/**/*.ts\" \"client/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  }
}
